# Anthropic — primary reasoning model (prize sponsor)
ANTHROPIC_API_KEY=

# Google Gemini — fallback model
GOOGLE_GEMINI_API_KEY=

# HuggingFace — dataset download (SageBio/mva-hackathon-2026-data)
HF_TOKEN=

# ChromaDB — local persistent vector store
CHROMA_PERSIST_DIRECTORY=./chroma_db

# PubMed Entrez API — required for polite NCBI access
PUBMED_EMAIL=ibiezugbeemmanuel@gmail.com

# OpenTargets / ChEMBL — public APIs, no key required by default
# OPENTARGETS_API_URL=https://api.platform.opentargets.org/api/v4/graphql
# CHEMBL_API_URL=https://www.ebi.ac.uk/chembl/api/data

# FastAPI report server
API_HOST=0.0.0.0
API_PORT=8000

# Prometheus metrics
METRICS_PORT=9090
